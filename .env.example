# RecoverForge Environment Configuration Template
# Populate these with your actual configuration (DO NOT commit real values)

# Application & Networking
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=

# Authentication (Server fails fast if JWT_SECRET is not provided)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Razorpay API Credentials & Webhook Secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Default Merchant Assignment (Fallback merchant ID for webhooks without notes.merchantId)
DEFAULT_MERCHANT_ID=

# AI Engine (OpenAI API key for gpt-4o-mini classification and recovery copy)
OPENAI_API_KEY=

# Resend Email Service (Fallback: preview logged to timeline meta if missing)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP Email Configuration (Nodemailer fallback for merchant OTP verification)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin Bootstrap Credentials (Used only by backend/scripts/createAdmin.js)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
